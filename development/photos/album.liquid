---
pagination:
  alias: album
  data: photos.albums
  size: 1
permalink: "photos/{{ album.title | slugify }}/"
---

<!DOCTYPE html>
<html lang="en">

	{%- for photo in album.photos -%}
		{%- if forloop.first == true or photo[1][0] == '^' -%}
			{%- assign thumbnail = photo[0] -%}
		{%- endif -%}
	{%- endfor -%}

	{%- assign root = album.root | default: 'vrc' -%}
	{%- assign folder = album.title | slugify %}
	{%- assign thumbnail = "https://cdn.m0b1.dev/" | concat: root | concat: '/' | concat: folder | concat: '/' | concat: thumbnail -%}
	{% render "head", title: page.url, ogTitle: album.title, thumbnail: thumbnail %}

	<body>
		<main>

			<h1>
				<a href="/photos" title="Return">&lArr;</a>
				{{ album.title }}
			</h1>

			<hr>

			{%- for photo in album.photos -%}

				{%- assign altText = album.title | concat: ': ' | concat: photo[0] -%}

				{%- render "image",
					index: forloop.index,
					folder: album.title,
					file: photo[0],
					root: root,
					altText: altText
				-%}

			{%- endfor -%}

		</main>
	</body>

</html>
